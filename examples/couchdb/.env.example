# Variables for the example docker-compose
# Copy to .env: cp .env.example .env

# Host-exposed port
COUCHDB_PORT=5984

# Admin user created by the container (COUCHDB_USER/COUCHDB_PASSWORD)
COUCH_ADMIN_USER=admin
COUCH_ADMIN_PASS=admin_password

# MySync plugin user/role (used by setup_couchdb.sh)
COUCH_PLUGIN_USER=mysync_user
COUCH_PLUGIN_PASS=mysync_password
COUCH_PLUGIN_ROLE=mysync_role

# Database and host
COUCH_DB=mysync
COUCH_HOST=http://127.0.0.1:5984
